(component
  (core module $named
    (memory (export "memory") 2)
    (table 1 16 funcref)
    (func (export "add") (param i64 i64) (result i64)
      local.get 0 local.get 1 i64.add)
    (func (export "grow") (param i32) (result i64)
      local.get 0 memory.grow i64.extend_i32_s)
    (func (export "table-grow") (param i32) (result i64)
      ref.null func local.get 0 table.grow i64.extend_i32_s)
    (func (export "non-finite") (result f64) f64.const nan)
    (func (export "oversized") (result i32)
      i32.const 4 i32.const 100000 i32.store i32.const 0))
  (core instance $i (instantiate $named))
  (alias core export $i "memory" (core memory $mem))
  (alias core export $i "add" (core func $add))
  (alias core export $i "grow" (core func $grow))
  (alias core export $i "table-grow" (core func $table-grow))
  (alias core export $i "non-finite" (core func $non-finite))
  (alias core export $i "oversized" (core func $oversized))
  (type $add-type (func (param "a" s64) (param "b" s64) (result s64)))
  (type $grow-type (func (param "pages" u32) (result s64)))
  (type $float-type (func (result float64)))
  (type $bytes (list u8))
  (type $bytes-type (func (result $bytes)))
  (func (export "add") (type $add-type) (canon lift (core func $add)))
  (func (export "grow") (type $grow-type) (canon lift (core func $grow)))
  (func (export "table-grow") (type $grow-type) (canon lift (core func $table-grow)))
  (func (export "non-finite") (type $float-type) (canon lift (core func $non-finite)))
  (func (export "oversized") (type $bytes-type) (canon lift (core func $oversized) (memory $mem))))
