[Unit]
Description=Isolated Barn bug-discovery guest
Requires=barn-compute-network.service var-lib-barncompute.mount
After=barn-compute-network.service var-lib-barncompute.mount network-online.target
RequiresMountsFor=/var/lib/barncompute

[Service]
User=barncompute
Group=barncompute
SupplementaryGroups=kvm
WorkingDirectory=/var/lib/barncompute
ExecStart=/usr/bin/qemu-system-x86_64 -name barn-compute -machine q35,accel=kvm -cpu host -smp 24 -m 32768-nodefaults -no-user-config -display none -monitor none -serial stdio -device virtio-rng-pci -drive file=/var/lib/barncompute/guest.qcow2,format=qcow2,if=virtio -drive file=/var/lib/barncompute/seed.iso,format=raw,if=virtio,readonly=on -netdev user,id=net0,ipv6=off,hostfwd=tcp:127.0.0.1:22822-:22 -device virtio-net-pci,netdev=net0,mac=52:54:00:ba:00:01
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
KillSignal=SIGTERM
MemoryMax=36G
MemorySwapMax=0
CPUQuota=2400%
CPUWeight=10
IOWeight=10
TasksMax=256
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
ReadWritePaths=/var/lib/barncompute
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
LogNamespace=barn-compute
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
