# This table owns only packets generated by the dedicated QEMU account.
# Do not flush the host ruleset or change production tables.
add table inet barn_compute
flush table inet barn_compute
table inet barn_compute {
    chain output {
        type filter hook output priority 10; policy accept;
        meta skuid "barncompute" jump guest_egress
    }
    chain guest_egress {
        # Host-initiated loopback SSH forwarding needs its established replies.
        ct state established,related accept
        fib daddr type local counter reject
        meta nfproto ipv6 counter reject
        ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } counter reject
        ip daddr { 1.1.1.1, 9.9.9.9 } udp dport 53 accept
        ip daddr { 1.1.1.1, 9.9.9.9 } tcp dport 53 accept
        tcp dport { 80, 443 } accept
        counter reject
    }
}
