owner = create($nothing);
o = create($nothing, owner);
add_property(#1, "conformance_suspended_move_exitfunc", o, {player, ""});
for name in ({"thing", "origin", "dest"})
add_property(o, name, #-1, {owner, ""});
endfor
for name in ({"log", "stack"})
add_property(o, name, {}, {owner, ""});
endfor
add_property(o, "result", 0, {owner, ""});
add_property(o, "finished", 0, {owner, ""});
o.thing = create($nothing, owner);
o.origin = create($nothing, owner);
o.dest = create($nothing, owner);
for x in ({o.origin, o.dest})
add_property(x, "driver", o, {owner, ""});
endfor
move(o.thing, o.origin);
for hook in ({{o.dest, "accept", 0}, {o.origin, "exitfunc", 1}, {o.dest, "enterfunc", 0}})
{where, name, pause} = hook;
add_verb(where, {owner, "rxd", name}, {"this", "none", "this"});
code = {"o = this.driver;", "o.log = {@o.log, verb};"};
if (pause)
code = {@code, "suspend(20);", "o.log = {@o.log, verb + \" resumed\"};", "for c in (callers()) o.stack = {@o.stack, c[2]}; endfor"};
endif
errors = set_verb_code(where, name, {@code, "return 1;"});
if (errors)
raise(E_INVARG, "hook compile failed", errors);
endif
endfor
add_verb(o, {owner, "rxd", "start"}, {"this", "none", "this"});
errors = set_verb_code(o, "start", {"this.result = {move(this.thing, this.dest)};", "this.finished = this.finished + 1;"});
if (errors)
raise(E_INVARG, "start compile failed", errors);
endif
fork (0)
o:start();
endfork
return 0;
